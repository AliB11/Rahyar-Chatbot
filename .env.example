# اتصال پایگاه داده اصلی (الزامی برای اجرای برنامه؛ برای `next build` لازم نیست)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# کلید رمزنگاری سمت سرور برای نشانی‌ها، توکن API و اعتبارنامه منابع.
# در استقرار واقعی حتماً یک مقدار تصادفی پایدار تنظیم کنید؛ با تغییر آن
# داده‌های رمزنگاری‌شده موجود قابل رمزگشایی نخواهند بود.
# APP_ENCRYPTION_KEY=

# اختیاری — سرویس سازگار با OpenAI برای embedding و تولید پاسخ مستند
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
